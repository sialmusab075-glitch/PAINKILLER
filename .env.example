# Database (SQLite for now; switch provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Public base URL for magic links and Stripe redirects (required in production)
APP_URL=http://localhost:3000

# Signs the stateless session JWT. At least 32 chars, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# AI (LangChain + Groq)
AI_API_KEY=your_groq_api_key
AI_MODEL=openai/gpt-oss-120b

# Stripe: the $5/month plan is defined in code (lib/pricing.ts), no Price id needed
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Magic-link email via nodemailer (SMTP). Optional in development: without
# SMTP_HOST, links are printed to the server console. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AI Resume Checker <no-reply@example.com>"
